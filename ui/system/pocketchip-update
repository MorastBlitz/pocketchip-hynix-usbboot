#!/bin/sh
# OS update for the PocketCHIP console (EINSTELLUNGEN > UPDATE).
#   pocketchip-update check     refresh package lists, print "UPG <pkg> <version>"
#   pocketchip-update upgrade   install the updates, log to /var/log/pocketchip-update.log
# The console starts "upgrade" as its own unit (pocketchip-update.service via
# systemd-run), so it keeps running when the console restarts.
#
# Kernel: a new kernel ABI comes in as a new package, so keep --with-new-pkgs.
# pocketchip-update-extlinux (kernel postinst/postrm hook from rootfs/) then
# rewrites /boot/extlinux/extlinux.conf; the new kernel is used after a reboot.
set -u
export DEBIAN_FRONTEND=noninteractive LC_ALL=C
LOG=/var/log/pocketchip-update.log

case "${1:-}" in
check)
  apt-get update -q >/dev/null 2>/tmp/pocketchip-update-check.err || {
    tail -n 3 /tmp/pocketchip-update-check.err
    exit 1
  }
  apt list --upgradable 2>/dev/null | sed -n 's#^\([^/]*\)/[^ ]* \([^ ]*\) .*#UPG \1 \2#p'
  ;;
upgrade)
  {
    echo "=== $(date '+%F %T') pocketchip-update"
    apt-get update -q
    apt-get -y -q --with-new-pkgs \
      -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold \
      upgrade
    rc=$?
    echo "EXIT=$rc"
    exit $rc
  } >"$LOG" 2>&1
  ;;
*)
  echo "usage: $0 check|upgrade" >&2
  exit 2
  ;;
esac

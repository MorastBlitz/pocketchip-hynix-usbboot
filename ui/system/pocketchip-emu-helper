#!/usr/bin/python3
"""Helper for emulators on the PocketCHIP: touch as mouse and pause menu.

Touch: 
SDL 2.32's evdev backend loses single-touch screens: it sends finger id -1
(which ScummVM treats as "no finger") and makes no mouse events for touch
without a window. This bridge grabs the touchscreen, applies the libinput
calibration matrix from /etc/default/pocketchip-touch and offers a virtual
absolute mouse (uinput): touch = left button, drag = move with button held.

Power key: freezes the emulator, takes DRM master from it (through a copy of
its file descriptor, pidfd_getfd) and starts the console's pause menu
(pocketchip-console --overlay). Afterwards it gives master and the picture
back, throws away the input the emulator would otherwise see and thaws it.

Runs as pocketchip-emu-helper.service (under systemd-inhibit, so logind
ignores the power key) while an emulator runs.
"""
import array, ctypes, fcntl, glob, os, select, shlex, socket, stat, struct, subprocess, sys, time

DEFAULTS = "/etc/default/pocketchip-touch"
EV_SYN, EV_KEY, EV_ABS = 0, 1, 3
ABS_X, ABS_Y, BTN_TOUCH, BTN_LEFT, BTN_RIGHT, BTN_MIDDLE = 0, 1, 0x14a, 0x110, 0x111, 0x112
EVIOCGABS = 0x80184540
EVIOCGRAB = 0x40044590
UI_SET_EVBIT, UI_SET_KEYBIT, UI_SET_ABSBIT = 0x40045564, 0x40045565, 0x40045567
UI_DEV_CREATE, UI_DEV_DESTROY = 0x5501, 0x5502
UI_DEV_SETUP = 0x405c5503   # struct uinput_setup, 92 bytes
UI_ABS_SETUP = 0x401c5504   # struct uinput_abs_setup, 28 bytes
EV = struct.Struct("llHHi")  # struct input_event on 32-bit ARM
OUT_MAX = 4095
KEY_POWER = 116
CONSOLE = "/usr/local/bin/pocketchip-console"
EXIT_QUIT_EMU = 10


def drm_iowr(nr, size):
    return (3 << 30) | (size << 16) | (0x64 << 8) | nr


DRM_SET_MASTER, DRM_DROP_MASTER = 0x641E, 0x641F
DRM_GETRESOURCES, DRM_GETCRTC, DRM_SETCRTC = drm_iowr(0xA0, 64), drm_iowr(0xA1, 104), drm_iowr(0xA2, 104)
libc = ctypes.CDLL(None, use_errno=True)
SYS_PIDFD_GETFD = 438


def pidfd_getfd(pid, fd):
    pfd = os.pidfd_open(pid)
    try:
        r = libc.syscall(SYS_PIDFD_GETFD, pfd, fd, 0)
        if r < 0:
            raise OSError(ctypes.get_errno(), "pidfd_getfd")
        return r
    finally:
        os.close(pfd)


def drm_ids(fd):
    """(crtc ids, connector ids) of a DRM device."""
    res = bytearray(64)
    fcntl.ioctl(fd, DRM_GETRESOURCES, res)
    ncrtc, nconn = struct.unpack_from("I", res, 36)[0], struct.unpack_from("I", res, 40)[0]
    crtcs, conns = array.array("I", [0] * max(1, ncrtc)), array.array("I", [0] * max(1, nconn))
    res = bytearray(64)
    struct.pack_into("Q", res, 8, crtcs.buffer_info()[0])
    struct.pack_into("Q", res, 16, conns.buffer_info()[0])
    struct.pack_into("4I", res, 32, 0, ncrtc, nconn, 0)
    fcntl.ioctl(fd, DRM_GETRESOURCES, res)
    return list(crtcs[:ncrtc]), list(conns[:nconn])


def active_emulator():
    """(unit, label, cgroup path) of the running pocketchip-emu@ unit."""
    out = subprocess.run(["systemctl", "list-units", "--state=active", "--plain", "--no-legend", "pocketchip-emu@*.service"],
                         capture_output=True, text=True).stdout.split()
    if not out:
        return None
    unit = out[0]
    label = unit.split("@", 1)[1].rsplit(".", 1)[0]
    cg = subprocess.run(["systemctl", "show", "-p", "ControlGroup", "--value", unit], capture_output=True, text=True).stdout.strip()
    return unit, label, "/sys/fs/cgroup" + cg


def proc_fds(cgroup, pred):
    """[(pid, fd)] of the processes in a cgroup whose fd target matches pred."""
    found = []
    try:
        pids = [int(p) for p in open(cgroup + "/cgroup.procs").read().split()]
    except OSError:
        return found
    for pid in pids:
        try:
            for fd in os.listdir(f"/proc/{pid}/fd"):
                try:
                    if pred(os.readlink(f"/proc/{pid}/fd/{fd}")):
                        found.append((pid, int(fd)))
                except OSError:
                    pass
        except OSError:
            pass
    return found


def drain(fds):
    """Read and discard everything queued on these (evdev) descriptors."""
    for fd in fds:
        try:
            while select.select([fd], [], [], 0)[0]:
                if not os.read(fd, 4096):
                    break
        except OSError:
            pass


def conf():
    c = {}
    try:
        for line in open(DEFAULTS):
            if "=" in line and not line.lstrip().startswith("#"):
                k, v = line.strip().split("=", 1)
                c[k] = " ".join(shlex.split(v))
    except OSError:
        pass
    return c


def device(name):
    for ev in sorted(glob.glob("/sys/class/input/event*")):
        try:
            if open(ev + "/device/name").read().strip() == name:
                return "/dev/input/" + os.path.basename(ev)
        except OSError:
            pass
    return None


def notify(msg):
    path = os.environ.get("NOTIFY_SOCKET")
    if not path:
        return
    if path.startswith("@"):
        path = "\0" + path[1:]
    s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    s.sendto(msg.encode(), path)
    s.close()


def main():
    c = conf()
    src = device(c.get("POCKETCHIP_TOUCH_DEVICE", "1c25000.rtp"))
    if not src:
        sys.exit("Touchscreen nicht gefunden")
    try:
        m = [float(x) for x in c["POCKETCHIP_TOUCH_MATRIX"].split()[:6]]
    except (KeyError, ValueError):
        m = [1, 0, 0, 0, 1, 0]
    fin = os.open(src, os.O_RDONLY)
    pek_dev = device("axp20x-pek")
    pek = os.open(pek_dev, os.O_RDONLY | os.O_NONBLOCK) if pek_dev else None
    rng = []
    for axis in (ABS_X, ABS_Y):
        b = array.array("i", [0] * 6)
        fcntl.ioctl(fin, EVIOCGABS + axis, b)
        rng.append((b[1], max(1, b[2] - b[1])))

    out = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
    fcntl.ioctl(out, UI_SET_EVBIT, EV_KEY)
    fcntl.ioctl(out, UI_SET_EVBIT, EV_ABS)
    # exactly left/right/middle: the kernel's joydev then skips it as an
    # absolute mouse instead of adding a phantom joystick
    for b in (BTN_LEFT, BTN_RIGHT, BTN_MIDDLE):
        fcntl.ioctl(out, UI_SET_KEYBIT, b)
    for axis in (ABS_X, ABS_Y):
        fcntl.ioctl(out, UI_SET_ABSBIT, axis)
        fcntl.ioctl(out, UI_ABS_SETUP, struct.pack("HH6i", axis, 0, 0, 0, OUT_MAX, 0, 0, 0))
    name = b"PocketCHIP Touch-Maus"
    fcntl.ioctl(out, UI_DEV_SETUP, struct.pack("HHHH80sI", 0x06, 0x1209, 0x0001, 1, name, 0))
    fcntl.ioctl(out, UI_DEV_CREATE)
    # the raw touchscreen stays hidden from SDL while the bridge runs
    fcntl.ioctl(fin, EVIOCGRAB, 1)

    def emit(events):
        os.write(out, b"".join(EV.pack(0, 0, t, k, v) for t, k, v in events + [(EV_SYN, 0, 0)]))

    # wait until udev has made the new device readable for the user
    for _ in range(50):
        if any("Touch-Maus" in open(n).read() for n in glob.glob("/sys/class/input/input*/name")):
            break
        select.select([], [], [], 0.05)
    select.select([], [], [], 0.3)
    notify("READY=1")

    raw = [0, 0]
    touching = down = False
    have_pos = False
    power_down = False
    watch = [fin] + ([pek] if pek is not None else [])
    while True:
        ready = select.select(watch, [], [])[0]
        if pek is not None and pek in ready:
            data = os.read(pek, EV.size * 16)
            for i in range(0, len(data) - EV.size + 1, EV.size):
                _, _, t, k, v = EV.unpack_from(data, i)
                if t == EV_KEY and k == KEY_POWER:
                    if v == 1:
                        power_down = True
                    elif v == 0 and power_down:
                        # on release, so the menu does not see it
                        power_down = False
                        if down:
                            emit([(EV_KEY, BTN_LEFT, 0)])
                            down = False
                        pause_menu(fin, pek)
                        touching = have_pos = False
        if fin not in ready:
            continue
        data = os.read(fin, EV.size * 64)
        for i in range(0, len(data) - EV.size + 1, EV.size):
            _, _, t, k, v = EV.unpack_from(data, i)
            if t == EV_ABS and k in (ABS_X, ABS_Y):
                raw[k] = v
                have_pos = True
            elif t == EV_KEY and k == BTN_TOUCH:
                touching = bool(v)
            elif t == EV_SYN and k == 0:
                if touching and have_pos:
                    nx = (raw[0] - rng[0][0]) / rng[0][1]
                    ny = (raw[1] - rng[1][0]) / rng[1][1]
                    x = m[0] * nx + m[1] * ny + m[2]
                    y = m[3] * nx + m[4] * ny + m[5]
                    x = min(OUT_MAX, max(0, round(x * OUT_MAX)))
                    y = min(OUT_MAX, max(0, round(y * OUT_MAX)))
                    # position first, button in its own frame: SDL sends the
                    # button at the position of the last completed frame
                    emit([(EV_ABS, ABS_X, x), (EV_ABS, ABS_Y, y)])
                    if not down:
                        emit([(EV_KEY, BTN_LEFT, 1)])
                        down = True
                elif not touching:
                    if down:
                        emit([(EV_KEY, BTN_LEFT, 0)])
                        down = False
                    have_pos = False


def pause_menu(fin, pek):
    emu = active_emulator()
    if not emu:
        return
    unit, label, cgroup = emu
    subprocess.run(["systemctl", "freeze", unit], capture_output=True)
    dups, inputs = [], []
    master = saved = None
    code = 0
    try:
        for pid, fd in proc_fds(cgroup, lambda t: t.startswith("/dev/dri/card")):
            try:
                dups.append(pidfd_getfd(pid, fd))
            except OSError:
                pass
        for pid, fd in proc_fds(cgroup, lambda t: t.startswith("/dev/input/")):
            try:
                inputs.append(pidfd_getfd(pid, fd))
            except OSError:
                pass
        # remember what the emulator shows, then take master away from it
        for d in dups:
            try:
                crtcs, conns = drm_ids(d)
                for c in crtcs:
                    cr = bytearray(104)
                    struct.pack_into("I", cr, 12, c)
                    fcntl.ioctl(d, DRM_GETCRTC, cr)
                    if struct.unpack_from("I", cr, 16)[0]:
                        saved = (cr, conns)
                        break
                break
            except OSError:
                pass
        for d in dups:
            try:
                fcntl.ioctl(d, DRM_DROP_MASTER)
                master = d
                break
            except OSError:
                pass
        fcntl.ioctl(fin, EVIOCGRAB, 0)
        env = dict(os.environ, SLINT_BACKEND="linuxkms-software")
        env.pop("NOTIFY_SOCKET", None)
        try:
            code = subprocess.run([CONSOLE, "--overlay", label], stdin=subprocess.DEVNULL, env=env).returncode
        except OSError as e:
            print(f"Pausenmenue: {e}", file=sys.stderr)
        fcntl.ioctl(fin, EVIOCGRAB, 1)
        # the console has closed the device: master and picture back
        if master is not None:
            for _ in range(20):
                try:
                    fcntl.ioctl(master, DRM_SET_MASTER)
                    break
                except OSError:
                    time.sleep(0.05)
            if saved:
                cr, conns = saved
                ids = array.array("I", conns[:1])
                struct.pack_into("QI", cr, 0, ids.buffer_info()[0], len(ids))
                try:
                    fcntl.ioctl(master, DRM_SETCRTC, cr)
                except OSError as e:
                    print(f"Bild zurueck: {e}", file=sys.stderr)
        # key presses and taps from the menu must not reach the game
        drain(inputs + [fin] + ([pek] if pek is not None else []))
    finally:
        for d in dups + inputs:
            os.close(d)
        subprocess.run(["systemctl", "thaw", unit], capture_output=True)
    if code == EXIT_QUIT_EMU:
        subprocess.run(["systemctl", "stop", "--no-block", unit])


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass

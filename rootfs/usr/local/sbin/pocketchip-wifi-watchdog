#!/bin/sh
# WLAN-Waechter fuer den RTL8723BS (r8723bs, staging) im PocketCHIP.
#
# Problem: Beim Wechsel zwischen mehreren Access Points mit gleicher SSID
# (Mesh/Repeater) bleibt der Treiber haengen. wpa_supplicant meldet dann
# endlos "Association request to the driver failed" (oder spaeter nur noch
# "Authentication ... timed out") und das Geraet bleibt offline.
#
# Loesung: Ist das WLAN nicht verbunden und treten diese Fehler gehaeuft auf,
# wird der Chip komplett zurueckgesetzt: Treiber entladen, SDIO-Controller
# vom Treiber trennen und neu verbinden. Dabei schaltet mmc-pwrseq die
# Versorgung/Reset-Leitung des Chips. Nur das Modul neu zu laden reicht
# nicht: der Chip bleibt dann haengen ("Authentication timed out").
set -u

INTERVAL="${WIFI_WATCHDOG_INTERVAL:-60}"   # Pruefintervall in Sekunden
WINDOW="${WIFI_WATCHDOG_WINDOW:-3min}"     # Zeitfenster fuer Fehlermeldungen
THRESHOLD="${WIFI_WATCHDOG_THRESHOLD:-3}"  # Mindestanzahl Fehlermeldungen
COOLDOWN="${WIFI_WATCHDOG_COOLDOWN:-300}"  # Mindestabstand zwischen Resets
MMC="${WIFI_WATCHDOG_MMC:-1c0f000.mmc}"    # SDIO-Controller des WLAN-Chips
DRV=/sys/bus/platform/drivers/sunxi-mmc
PATTERN='Association request to the driver failed|Authentication with .* timed out'
last_reset=0

log() { echo "pocketchip-wifi-watchdog: $*"; }

reset_chip() {
  log "WLAN haengt ($1 Fehler in $WINDOW) - setze Chip zurueck"
  nmcli radio wifi off
  sleep 2
  modprobe -r r8723bs
  if [ -e "$DRV/$MMC" ]; then
    echo "$MMC" >"$DRV/unbind"
    sleep 2
    echo "$MMC" >"$DRV/bind"
  fi
  # udev laedt r8723bs wieder, sobald der SDIO-Chip erkannt ist
  i=0
  while [ ! -e /sys/class/net/wlan0 ] && [ "$i" -lt 30 ]; do
    i=$((i + 1)); sleep 1
  done
  [ -e /sys/class/net/wlan0 ] || modprobe r8723bs
  sleep 3
  nmcli radio wifi on
  last_reset=$(date +%s)
  log "Reset fertig (wlan0 $( [ -e /sys/class/net/wlan0 ] && echo da || echo fehlt ))"
}

[ "${1:-}" = --reset-now ] && { reset_chip manuell; exit 0; }

while sleep "$INTERVAL"; do
  [ "$(nmcli -t -f WIFI general 2>/dev/null)" = enabled ] || continue
  state="$(nmcli -t -f DEVICE,STATE device 2>/dev/null | awk -F: '$1=="wlan0"{print $2}')"
  [ "$state" = connected ] && continue
  fails="$(journalctl -q -u wpa_supplicant --since "-$WINDOW" 2>/dev/null \
            | grep -c -E "$PATTERN")"
  now=$(date +%s)
  if [ "$fails" -ge "$THRESHOLD" ] && [ $((now - last_reset)) -ge "$COOLDOWN" ]; then
    reset_chip "$fails"
  fi
done

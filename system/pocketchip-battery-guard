#!/bin/sh
# Power the PocketCHIP off when the battery is empty, also while the console
# is not running (e.g. during an emulator). The console itself warns at the
# warning level and powers off after a 30 s countdown; this guard acts later
# (about 2 minutes at or below the level) as a fallback.
# The level comes from the console settings (battery_off, 0 = never).
set -u
BAT=/sys/class/power_supply/axp20x-battery
USB=/sys/class/power_supply/axp20x-usb
AC=/sys/class/power_supply/axp20x-ac
SETTINGS=/var/lib/pocketchip-console/settings.conf
INTERVAL=30
NEEDED=4   # consecutive low readings (4 x 30 s)

rd() { cat "$1" 2>/dev/null || echo "${2:-}"; }
level() {
  v=$(sed -n 's/^battery_off=\([0-9]*\)$/\1/p' "$SETTINGS" 2>/dev/null | tail -n 1)
  echo "${v:-5}"
}

low=0
while :; do
  off=$(level)
  cap=$(rd "$BAT/capacity" -1)
  status=$(rd "$BAT/status" Unknown)
  present=$(rd "$BAT/present" 0)
  ext=0
  [ "$(rd "$USB/online" 0)" = 1 ] && ext=1
  [ "$(rd "$AC/online" 0)" = 1 ] && ext=1
  if [ "$off" -gt 0 ] && [ "$present" = 1 ] && [ "$ext" = 0 ] && [ "$status" != Charging ] \
     && [ "$cap" -ge 0 ] && [ "$cap" -le "$off" ]; then
    low=$((low + 1))
    echo "battery low: ${cap}% <= ${off}% ($low/$NEEDED)"
    if [ "$low" -ge "$NEEDED" ]; then
      echo "battery empty, powering off"
      systemctl poweroff
      exit 0
    fi
  else
    low=0
  fi
  sleep "$INTERVAL"
done
